real_timestamp = parse_timestamp!(.timestamp, format: "%Y-%m-%dT%H:%M:%S%z")
service_name = .appname
severity_text = if includes(["emerg", "err", "crit", "alert"], .severity) {
    "Error"
} else if .severity == "warning" {
    "Warn"
} else if .severity == "debug" {
    "Debug"
} else if includes(["info", "notice"], .severity) {
    "Info"
} else {
    .severity
}
body = if service_name == "nginx" {
    nginx_log = parse_nginx_log!(.message, "error")
    .kind = "error"
    .remote_addr = nginx_log.client
    .pid = nginx_log.pid

    geoip, err = get_enrichment_table_record("GeoIP2-Country", { "ip":  .remote_addr })
    if err == null {
        .country = geoip.country.iso_code
    }

    .host = if nginx_log.server != null {
        nginx_log.server
    } else {
        nginx_log.host
    }
    if nginx_log.request != null {
        nginx_request = split!(nginx_log.request, " ")
        .method = nginx_request[0]
        .uri = nginx_request[1]
    }

    nginx_log.message
} else {
    .message
}

del(.appname)
del(.message)
del(.facility)
del(.severity)
del(.hostname)
del(.timestamp)

attributes = []

for_each(object!(.)) -> |key, value| {
    value = if is_integer(value) { { "intValue": value } } else if is_float(value) { { "doubleValue": value } } else { { "stringValue": to_string!(value) } }
    attributes = append(attributes, [{ "key": key, "value": value }])
}

del(.)

.resourceLogs = [{
    "resource": {
        "attributes": [
            { "key": "service.name", "value": { "stringValue": service_name } },
            { "key": "source_type", "value": { "stringValue": "syslog" } },
        ]
    },
    "scopeLogs": [{
        "scope": {
            "name": "nginx"
        },
        "logRecords": [{
            "timeUnixNano": to_unix_timestamp(real_timestamp, unit: "nanoseconds"),
            "body": { "stringValue": body },
            "severityText": severity_text,
            "eventName": "Syslog",
            "attributes": attributes
        }]
    }]
}]
